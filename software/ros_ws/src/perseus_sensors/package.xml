<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>perseus_sensors</name>
  <version>0.1.0</version>
  <description>Perseus-lite sensor drivers and processing: I2C IMU driver (/imu/data), IMU gyro bias estimator/remover components, a generic topic rate remapper, and the RPLidar C1 runtime dependency.</description>
  <maintainer email="1388693+DingoOz@users.noreply.github.com">DingoOz</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- fd_wrapper comes from software/shared and is built in-tree via add_subdirectory -->
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>backward_ros</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rplidar_ros</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
