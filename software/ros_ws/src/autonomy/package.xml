<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>autonomy</name>
  <version>0.0.1</version>
  <description>ROAR Autonomy software control stack</description>
  <maintainer email="1388693+DingoOz@users.noreply.github.com">Nigel H-S</maintainer>
  
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>slam_toolbox</depend>
  <depend>navigation2</depend>
  <depend>xacro</depend>
  <depend>robot_localization</depend>
  <exec_depend>topic_tools</exec_depend>
  <!-- BT plugins loaded by bt_navigator (plugin_lib_names) -->
  <exec_depend>perseus_bt_nodes</exec_depend>
  <!-- handheld_mapping -->
  <exec_depend>rplidar_ros</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <!-- perseus_lite (robot bringup + scan_range_filter) is also used at launch
       time, but it declares an exec_depend on this package, so it cannot be
       listed here without creating a dependency cycle. -->


  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
