<?xml version="1.0"?>
<robot name="motor_wheel" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find perseus_lite_description)/urdf/wheel.urdf.xacro"/>

  <!-- MOTOR JOINT -->
  <xacro:macro name="motor_wheel" params="prefix:=^ side:=^ end *origin">
    <link name="${prefix}${end}_${side}_motor">
      <inertial>
        <origin xyz="0.0 0.1 0.0" rpy="0.0 0.0 0.0"/>
        <!-- ST3215 servo (~60 g) plus bracket. The previous 2.6 kg per motor (marked
             TEMP, carried over from the full-size Perseus) made the model 14.8 kg; at
             that mass simulated ST3215s (~3 N m) cannot turn the skid-steer, though the
             real robot turns. Estimate: weigh the robot and correct if needed. Inertia
             is that of the 50 x 50 x 37.5 mm collision box. -->
        <mass value="0.15"/>
        <inertia ixx="4.883e-05" iyy="4.883e-05" izz="6.250e-05" ixy="0.0" iyz="0.0" ixz="0.0"/>
      </inertial>

      <visual>
        <origin xyz="-0.0 0.0 0.0" rpy="0.0 0.0 ${pi/2}"/>
        <geometry>
          <mesh scale="0.05 0.05 0.05" filename="file://$(find perseus_lite_description)/meshes/gearbox.dae"/>
        </geometry>
        <!-- <material name="white"/> -->
      </visual>

      <collision>
        <origin xyz="-0.0 0.0 0.0" rpy="0.0 0.0 ${pi/2}"/>
        <geometry>
          <box size="0.05 0.05 0.0375" />
          <!--mesh scale="0.05 0.05 0.05" filename="file://$(find perseus_lite_description)/meshes/gearbox.dae"/-->
        </geometry>
      </collision>
    </link>

    <!-- JOINT -->
    <joint name="${prefix}${end}_${side}_motor_joint" type="fixed">
      <parent link="${prefix}${side}_rocker"/>
      <child link="${prefix}${end}_${side}_motor"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <!-- TRANSMISSION -->
    <!-- <transmission name="gear_ratio">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="bogie_${prefix}_to_motor_${prefix}_${suffix}">
        <hardwareInterface>EffortJointInterface</hardwareInterface>
      </joint>
      <actuator name="">
        <mechanicalReduction>30</mechanicalReduction>
        <hardwareInterface>EffortJointInterface</hardwareInterface>
      </actuator>
    </transmission> -->

    <xacro:wheel />
  </xacro:macro>
</robot>