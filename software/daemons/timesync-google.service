[Unit]
Description=Set time from an HTTPS Date header (www.google.com)
Documentation=file:///usr/local/sbin/timesync-google
# network-online.target is only meaningful if a *-wait-online service
# (systemd-networkd-wait-online / NetworkManager-wait-online) is enabled.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Exits non-zero (unit shows failed) if the fetch fails, the Date header is
# missing/unparseable, or it would step the clock back by more than 1 h.
ExecStart=/usr/local/sbin/timesync-google
RemainAfterExit=yes
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
