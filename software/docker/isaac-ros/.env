# Isaac ROS container stack — configuration.
# Copied by docker compose automatically (same directory as compose.yaml).
#
# NOTE: this file is committed on purpose — it contains no secrets, only image
# pins and domain/device defaults. Override per-host by editing in place or
# exporting the same names in the shell before `docker compose`.

# ---------------------------------------------------------------------------
# Base image (Isaac ROS 3.2 = ROS 2 Humble; the terminal release for Jetson
# Orin Nano — 4.x is Thor-only). NGC tags are content hashes and REQUIRE
# `docker login nvcr.io` with an NGC API key to pull. Confirm the exact hash
# for your board/JetPack against the Isaac ROS 3.2 release before deploying:
#   https://nvidia-isaac-ros.github.io/releases/index.html
# On x86 dev machines use the x86_64-ros2_humble_<hash> variant instead.
# ---------------------------------------------------------------------------
ISAAC_ROS_IMAGE=nvcr.io/nvidia/isaac/ros:aarch64-ros2_humble_4c0c55dddd2bbcc3e8d5f9753bee634c

# Eclipse zenoh DDS bridge image. Both bridge services MUST use the SAME tag
# (zenoh wire protocol must match end to end). Pin an explicit version.
ZENOH_BRIDGE_IMAGE=eclipse/zenoh-bridge-ros2dds:1.5.1

# ROS domains. The Humble container graph is ISOLATED on 52 so it never
# cross-discovers the Jazzy host (51) — raw Humble<->Jazzy DDS is incompatible.
# Only the zenoh bridges cross between them. Never assign 52 to a host env.
ISAAC_DOMAIN_ID=52
HOST_DOMAIN_ID=51

# Loopback TCP port the two bridges peer over (passed to both bridges as
# -l/-e tcp/127.0.0.1:${ZENOH_PORT} by compose.yaml).
ZENOH_PORT=7447

# Host camera device (USB/CSI mono). It is mapped to /dev/video0 INSIDE the
# container (what usb_cam is configured for), so any host device works. For a
# CSI camera via Argus this is unused — see the docs page for that variant.
CAMERA_DEVICE=/dev/video0

# TensorRT engine for the (not yet wired) YOLOv8 cube detector: 1 = build it in
# the background on start if missing. ISAAC_REBUILD_ENGINE=1 retries a build
# that previously failed (failures are remembered to avoid restart loops).
ISAAC_BUILD_ENGINE=0
ISAAC_REBUILD_ENGINE=0
